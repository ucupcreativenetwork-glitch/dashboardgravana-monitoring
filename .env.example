# =============================================================================
# DashboardGravana Monitoring Stack — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# All secrets must be rotated regularly. Prefer Docker secrets / Vault in prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=dashboardgravana
TZ=Asia/Jakarta
DOMAIN=monitoring.example.com
PUBLIC_URL=https://monitoring.example.com

# -----------------------------------------------------------------------------
# Network / Ports (bind only to required interfaces in production)
# -----------------------------------------------------------------------------
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
UPTIME_KUMA_PORT=3001
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
PVE_EXPORTER_PORT=9221
BLACKBOX_EXPORTER_PORT=9115

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SERVER_ROOT_URL=${PUBLIC_URL}
GF_INSTALL_PLUGINS=grafana-piechart-panel,grafana-clock-panel,marcusolsson-json-datasource
# Optional: SMTP for Grafana alerts / invites
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@example.com
GF_SMTP_FROM_NAME=DashboardGravana

# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB
# Optional remote_write (Thanos / Cortex / Mimir / Grafana Cloud)
# PROMETHEUS_REMOTE_WRITE_URL=
# PROMETHEUS_REMOTE_WRITE_USERNAME=
# PROMETHEUS_REMOTE_WRITE_PASSWORD=

# -----------------------------------------------------------------------------
# Alertmanager
# -----------------------------------------------------------------------------
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_FROM=alertmanager@example.com
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
ALERTMANAGER_SMTP_REQUIRE_TLS=true

# Discord webhook (full URL including token)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# -----------------------------------------------------------------------------
# Proxmox VE Exporter
# -----------------------------------------------------------------------------
PVE_USER=monitoring@pve
PVE_PASSWORD=CHANGE_ME
PVE_TOKEN_NAME=
PVE_TOKEN_VALUE=
# Comma-separated list of Proxmox nodes / cluster endpoints
PVE_TARGETS=https://pve1.example.com:8006,https://pve2.example.com:8006

# -----------------------------------------------------------------------------
# Node / Host targets (comma-separated host:port or just host for defaults)
# -----------------------------------------------------------------------------
NODE_EXPORTER_TARGETS=192.168.1.10:9100,192.168.1.11:9100
CADVISOR_TARGETS=192.168.1.10:8080
BLACKBOX_HTTP_TARGETS=https://example.com,https://status.example.com
BLACKBOX_ICMP_TARGETS=8.8.8.8,1.1.1.1

# -----------------------------------------------------------------------------
# Application exporters (optional — leave empty if not used)
# -----------------------------------------------------------------------------
MYSQL_EXPORTER_DSN=
REDIS_EXPORTER_ADDR=redis://redis:6379
NEXTCLOUD_URL=
NEXTCLOUD_TOKEN=

# -----------------------------------------------------------------------------
# Loki / Promtail
# -----------------------------------------------------------------------------
LOKI_RETENTION_PERIOD=744h
# Host path for journal / syslog if mounting from host
HOST_JOURNAL_PATH=/var/log/journal

# -----------------------------------------------------------------------------
# Security / TLS (recommended for production)
# -----------------------------------------------------------------------------
# Use reverse proxy (Nginx / Traefik / Caddy) in front of all services.
# TLS termination at the edge. Internal Docker network stays plain.
# Example: CERTBOT / Let's Encrypt or Cloudflare Origin certs.
