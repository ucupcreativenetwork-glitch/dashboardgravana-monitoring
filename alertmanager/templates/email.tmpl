{{ define "email.html" -}}
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>DashboardGravana Alert</title></head>
<body style="font-family: system-ui, sans-serif; background:#0b1220; color:#e2e8f0; padding:16px;">
  <div style="max-width:640px;margin:0 auto;background:#111827;border:1px solid #1f2937;border-radius:8px;padding:20px;">
    <h2 style="margin:0 0 8px;color:{{ if eq .Status "firing" }}#f87171{{ else }}#4ade80{{ end }};">
      {{ if eq .Status "firing" }}FIRING{{ else }}RESOLVED{{ end }}
      — {{ .CommonLabels.severity | toUpper }}
    </h2>
    <p style="margin:0 0 16px;font-size:16px;">{{ .CommonAnnotations.summary }}</p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;">
      <tr><td style="padding:6px 0;color:#94a3b8;">Alert</td><td><code>{{ .CommonLabels.alertname }}</code></td></tr>
      <tr><td style="padding:6px 0;color:#94a3b8;">Cluster</td><td><code>{{ .CommonLabels.cluster }}</code></td></tr>
    </table>
    <hr style="border:none;border-top:1px solid #1f2937;margin:16px 0;">
    {{ range .Alerts }}
    <div style="margin-bottom:16px;padding:12px;background:#0b1220;border-radius:6px;">
      <div><strong>Instance:</strong> <code>{{ .Labels.instance }}</code></div>
      <div style="margin-top:6px;">{{ .Annotations.description }}</div>
      <div style="margin-top:6px;color:#94a3b8;font-size:12px;">Started: {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}</div>
      {{ if .Annotations.dashboard_url }}
      <div style="margin-top:8px;"><a href="{{ .Annotations.dashboard_url }}" style="color:#60a5fa;">Open dashboard</a></div>
      {{ end }}
    </div>
    {{ end }}
    <p style="margin:16px 0 0;font-size:12px;color:#64748b;">DashboardGravana Monitoring · Alertmanager</p>
  </div>
</body>
</html>
{{- end }}
